@prefix hw3:  <http://taica.course/hw3/ontology#> .
@prefix cora: <http://purl.org/ieee1872-owl/cora-bare#> .
@prefix soma: <http://www.ease-crc.org/ont/SOMA.owl#> .
@prefix ta:  <http://taica.course/hw3/data/ta#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# TA-provided robot knowledge graph  (DO NOT MODIFY)
#
# This graph is the output of "another independently developed robotics
# program": the TA used their own IK program and a different arm (UR10)
# to publish results against the same shared target URIs (hw3:target_*).
# Your robot_graph.ttl and this graph use the same vocabulary (hw3:) and
# the same targets, so once both are loaded into the same triple store,
# SPARQL can query and compare across the graphs directly.
# =============================================================================

ta:ta_ur10 a cora:Robot ;
    hw3:producedBy "ta-reference-pipeline" ;
    hw3:hasDoF 6 ;
    hw3:hasJoint ta:ta_ur10_joint1 , ta:ta_ur10_joint2 , ta:ta_ur10_joint3 ,
                 ta:ta_ur10_joint4 , ta:ta_ur10_joint5 , ta:ta_ur10_joint6 .

# UR10 classic DH parameters (meters / radians)
ta:ta_ur10_joint1 a soma:RevoluteJoint ;
    hw3:jointIndex 1 ;
    hw3:dh_a "0.0"^^xsd:double ;     hw3:dh_d "0.1273"^^xsd:double ;   hw3:dh_alpha "1.570796"^^xsd:double .
ta:ta_ur10_joint2 a soma:RevoluteJoint ;
    hw3:jointIndex 2 ;
    hw3:dh_a "-0.612"^^xsd:double ;  hw3:dh_d "0.0"^^xsd:double ;      hw3:dh_alpha "0.0"^^xsd:double .
ta:ta_ur10_joint3 a soma:RevoluteJoint ;
    hw3:jointIndex 3 ;
    hw3:dh_a "-0.5723"^^xsd:double ; hw3:dh_d "0.0"^^xsd:double ;      hw3:dh_alpha "0.0"^^xsd:double .
ta:ta_ur10_joint4 a soma:RevoluteJoint ;
    hw3:jointIndex 4 ;
    hw3:dh_a "0.0"^^xsd:double ;     hw3:dh_d "0.163941"^^xsd:double ; hw3:dh_alpha "1.570796"^^xsd:double .
ta:ta_ur10_joint5 a soma:RevoluteJoint ;
    hw3:jointIndex 5 ;
    hw3:dh_a "0.0"^^xsd:double ;     hw3:dh_d "0.1157"^^xsd:double ;   hw3:dh_alpha "-1.570796"^^xsd:double .
ta:ta_ur10_joint6 a soma:RevoluteJoint ;
    hw3:jointIndex 6 ;
    hw3:dh_a "0.0"^^xsd:double ;     hw3:dh_d "0.0922"^^xsd:double ;   hw3:dh_alpha "0.0"^^xsd:double .

# --- IK results of the TA pipeline on the SHARED targets ---
# The UR10's reach (~1.3 m) is longer than the UR5's (~0.9 m), so
# target_mid is SOLVED for the UR10 while your UR5 should report
# OUT_OF_REACH for it.

ta:ik_ta_target_near a hw3:IKComputation ;
    hw3:producedBy "ta-reference-pipeline" ;
    hw3:computedForRobot ta:ta_ur10 ;
    hw3:solvesForTarget hw3:target_near ;
    hw3:hasIKStatus "SOLVED" ;
    hw3:hasResidual "0.0012"^^xsd:double ;
    hw3:hasJointConfiguration ta:ik_ta_target_near_q .

ta:ik_ta_target_near_q a hw3:JointConfiguration ;
    hw3:hasJointState ta:ik_ta_target_near_q_js1 , ta:ik_ta_target_near_q_js2 , ta:ik_ta_target_near_q_js3 , ta:ik_ta_target_near_q_js4 , ta:ik_ta_target_near_q_js5 , ta:ik_ta_target_near_q_js6 .
ta:ik_ta_target_near_q_js1 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint1 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-2.994"^^xsd:double .
ta:ik_ta_target_near_q_js2 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint2 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-1.237"^^xsd:double .
ta:ik_ta_target_near_q_js3 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint3 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "1.156"^^xsd:double .
ta:ik_ta_target_near_q_js4 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint4 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-1.489"^^xsd:double .
ta:ik_ta_target_near_q_js5 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint5 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-1.571"^^xsd:double .
ta:ik_ta_target_near_q_js6 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint6 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "0.147"^^xsd:double .

ta:ik_ta_target_mid a hw3:IKComputation ;
    hw3:producedBy "ta-reference-pipeline" ;
    hw3:computedForRobot ta:ta_ur10 ;
    hw3:solvesForTarget hw3:target_mid ;
    hw3:hasIKStatus "SOLVED" ;
    hw3:hasResidual "0.0038"^^xsd:double ;
    hw3:hasJointConfiguration ta:ik_ta_target_mid_q .

ta:ik_ta_target_mid_q a hw3:JointConfiguration ;
    hw3:hasJointState ta:ik_ta_target_mid_q_js1 , ta:ik_ta_target_mid_q_js2 , ta:ik_ta_target_mid_q_js3 , ta:ik_ta_target_mid_q_js4 , ta:ik_ta_target_mid_q_js5 , ta:ik_ta_target_mid_q_js6 .
ta:ik_ta_target_mid_q_js1 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint1 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-3.312"^^xsd:double .
ta:ik_ta_target_mid_q_js2 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint2 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-0.842"^^xsd:double .
ta:ik_ta_target_mid_q_js3 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint3 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "0.988"^^xsd:double .
ta:ik_ta_target_mid_q_js4 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint4 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-1.717"^^xsd:double .
ta:ik_ta_target_mid_q_js5 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint5 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-1.571"^^xsd:double .
ta:ik_ta_target_mid_q_js6 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint6 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-0.171"^^xsd:double .

ta:ik_ta_target_far a hw3:IKComputation ;
    hw3:producedBy "ta-reference-pipeline" ;
    hw3:computedForRobot ta:ta_ur10 ;
    hw3:solvesForTarget hw3:target_far ;
    hw3:hasIKStatus "OUT_OF_REACH" ;
    hw3:hasResidual "0.8091"^^xsd:double ;
    hw3:hasJointConfiguration ta:ik_ta_target_far_q .

ta:ik_ta_target_far_q a hw3:JointConfiguration ;
    hw3:hasJointState ta:ik_ta_target_far_q_js1 , ta:ik_ta_target_far_q_js2 , ta:ik_ta_target_far_q_js3 , ta:ik_ta_target_far_q_js4 , ta:ik_ta_target_far_q_js5 , ta:ik_ta_target_far_q_js6 .
ta:ik_ta_target_far_q_js1 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint1 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-3.142"^^xsd:double .
ta:ik_ta_target_far_q_js2 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint2 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-1.571"^^xsd:double .
ta:ik_ta_target_far_q_js3 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint3 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "1.571"^^xsd:double .
ta:ik_ta_target_far_q_js4 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint4 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-1.571"^^xsd:double .
ta:ik_ta_target_far_q_js5 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint5 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "-1.571"^^xsd:double .
ta:ik_ta_target_far_q_js6 a soma:JointState ;
    hw3:isStateOfJoint ta:ta_ur10_joint6 ;
    qudt:hasUnit unit:RAD ;
    soma:hasJointPosition "0.0"^^xsd:double .
