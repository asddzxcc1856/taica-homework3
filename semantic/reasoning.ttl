@prefix hw3:  <http://taica.course/hw3/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# =============================================================================
# Task 4 / REASONING — inference-defined evaluation classes
#
# OWL reasoner (run_task4.sh STEP 4) 會載入 ontology + 本檔 + 你的 data.ttl,
# 從你定義的 equivalentClass 公理「推導」出評估類的成員 —— 成員絕不手動
# assert,全部由推理導出 (概念分類交給 OWL;數值門檻檢查交給 SHACL)。
# 推導結果寫進 output/inferred.ttl,評分會檢查:
#     SolvedIKComputation    的成員 = {ik_target_near}
#     OutOfReachIKComputation 的成員 = {ik_target_mid, ik_target_far}
# 這與 SHACL 從「數值」發現的問題 (ARM_OUT_OF_RANGE) 互相印證 ——
# 符號層推理與數值層驗證必須一致。
# =============================================================================

# ---- Worked example (already implemented) -----------------------------------
# SolvedIKComputation ≡ IKComputation ⊓ (hasIKStatus value "SOLVED")
hw3:SolvedIKComputation a owl:Class ;
    rdfs:label "Solved IK Computation"@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            hw3:IKComputation
            [ a owl:Restriction ;
              owl:onProperty hw3:hasIKStatus ;
              owl:hasValue "SOLVED" ]
        )
    ] .

