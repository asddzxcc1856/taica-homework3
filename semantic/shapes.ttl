@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix hw3:  <http://taica.course/hw3/ontology#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# Task 4 / SHACL — validate your grounded execution data (output/data.ttl)
#
# SHACL shapes read grounded numeric values directly to discover execution
# issues in IK/FK. run_task4.sh invokes Jena's shacl CLI:
#     shacl validate --shapes shapes.ttl --data output/data.ttl
#     -> output/validation.ttl   (SHACL validation report, Turtle)
#
# Grading (1) uses the full TA shapes in ta-shapes-full.ttl to validate your
# data.ttl, and (2) uses your shapes.ttl against the TA's mixed 24-record
# execution dataset (ta-faulty-execution.ttl, including boundary values).
# Each record's flags must exactly match ta-answer-key.json: no false positives
# and no false negatives. The scorer identifies flags by sh:message prefix;
# use the required prefixes below. Thresholds must use sh:maxInclusive because
# the dataset includes values exactly equal to a threshold.
# =============================================================================

# ---- Worked example (already implemented): FK accuracy check ----------------
# FK pose error must not exceed the 0.005 m course threshold; otherwise report
# FK_INACCURATE.
hw3:FKAccuracyShape a sh:NodeShape ;
    sh:targetClass hw3:FKComputation ;
    sh:property [
        sh:path hw3:hasPoseError ;
        sh:maxInclusive "0.005"^^xsd:double ;
        sh:message "FK_INACCURATE: pose error above the 0.005 m course threshold" ;
    ] .

