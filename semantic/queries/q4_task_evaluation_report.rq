# Q4 (provided): Semantic evaluation report over Tasks 1 / 2 / 3.
# One inference-defined class per task:
#   Task 1 -> hw3:PassedFKComputation  (FK within the course error thresholds)
#   Task 2 -> hw3:SolvedIKComputation  (IK reached the target)
#   Task 3 -> hw3:SuccessfulEpisode    (insertion episode succeeded)
# None of these memberships is ever asserted by a program — the OWL reasoner
# derives all of them, and this single query reads the evaluation of all
# three tasks out of the triple store.
# (The TA reference pipeline is excluded so the report covers YOUR results;
#  drop the FILTER to see every robot/group in the store.)
PREFIX hw3: <http://taica.course/hw3/ontology#>

SELECT ?evalClass (COUNT(?item) AS ?count)
WHERE {
  VALUES ?evalClass { hw3:PassedFKComputation
                      hw3:SolvedIKComputation
                      hw3:SuccessfulEpisode }
  ?item a ?evalClass ;
        hw3:producedBy ?producedBy .
  FILTER(?producedBy != "ta-reference-pipeline")
}
GROUP BY ?evalClass
ORDER BY ?evalClass
