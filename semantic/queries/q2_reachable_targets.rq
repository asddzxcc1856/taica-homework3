# Q2 (provided): Use the INFERRED class to find the targets each arm solved.
# Note: no program ever writes hw3:SolvedIKComputation into the data —
# the OWL reasoner derives it from the equivalent-class definition
# (IKComputation AND hasIKStatus "SOLVED"). If you skip the reasoning step
# of run_task4.sh, this query returns nothing.
PREFIX hw3:  <http://taica.course/hw3/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?robot ?target ?residual
WHERE {
  ?ik a hw3:SolvedIKComputation ;
      hw3:computedForRobot ?robot ;
      hw3:solvesForTarget ?target .
  OPTIONAL { ?ik hw3:hasResidual ?residual }
}
ORDER BY ?robot ?target
