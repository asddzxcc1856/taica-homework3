# (Bonus / Semantic Gate only, TA-provided)
# Select the grasp targets that are truly executable after OWL reasoning:
# the object must be classified by the reasoner as hw3:ExecutableGraspTarget
# (= hw3:GraspableObject AND hw3:isKinematicallyReachable true)
PREFIX hw3: <http://taica.course/hw3/ontology#>

SELECT ?obj ?label ?status ?err
WHERE {
  ?obj a hw3:ExecutableGraspTarget .
  OPTIONAL { ?obj hw3:hasObjectLabel ?label }
  OPTIONAL {
    ?task hw3:solvesForObject ?obj ;
          hw3:hasIKStatus ?status .
    OPTIONAL { ?task hw3:hasResidual ?err }
  }
}
ORDER BY ?obj
