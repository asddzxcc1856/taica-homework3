# Q1 (provided): Summarize the specification of every robot in the triple store.
# Key point: the store holds TWO robots — your UR5 and the TA's UR10 —
# produced independently by different programs, yet a single query retrieves
# both because they share the same hw3: vocabulary.
PREFIX hw3:  <http://taica.course/hw3/ontology#>
PREFIX cora: <http://purl.org/ieee1872-owl/cora-bare#>

SELECT ?robot ?producedBy ?dof (COUNT(?joint) AS ?jointCount)
WHERE {
  ?robot a cora:Robot ;
         hw3:producedBy ?producedBy ;
         hw3:hasDoF ?dof ;
         hw3:hasJoint ?joint .
}
GROUP BY ?robot ?producedBy ?dof
ORDER BY ?robot
