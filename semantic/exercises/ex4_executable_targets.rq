# Exercise 4 (TA-provided): 查出所有推理導出的 ExecutableGraspTarget。
# 由 ex4_semantic_gate.py 透過 SemanticReasoner 直接執行 (semantic-gate mode)。
PREFIX hw3:  <http://taica.course/hw3/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?obj ?label
WHERE {
  ?obj a hw3:ExecutableGraspTarget .
  OPTIONAL { ?obj rdfs:label ?label }
}
ORDER BY ?obj
