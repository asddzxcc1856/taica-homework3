# Exercise 1 · Joint Limit Audit  (STUDENT TODO)
#
# 目的: 利用 Semantic Knowledge Graph 檢查 IK solver 產生的 joint
# configuration 是否符合 robot joint limit。
#
#   IK Solution -> JointConfiguration -> JointState
#                      --isStateOfJoint--> Joint (lower/upper limit)
#
# ?audit = OK / BELOW_LOWER / ABOVE_UPPER
# 只看違規列: 取消最後 FILTER 行的註解 (參考解資料中 IK 解已被 solver
# clip 在限位內, 違規列預期為 0 — 想製造違規可停用 ik.py 的 np.clip)。
PREFIX hw3:  <http://taica.course/hw3/ontology#>
PREFIX soma: <http://www.ease-crc.org/ont/SOMA.owl#>

SELECT *   # STUDENT TODO: 改成題目要求的變數
WHERE {
  # ------------------------- your query -------------------------
  # hint: ?ik a hw3:IKComputation ; hw3:hasJointConfiguration ?cfg .
  # hint: ?cfg hw3:hasJointState ?js .  ?js hw3:isStateOfJoint ?joint ; soma:hasJointPosition ?angle .
  # hint: ?joint hw3:hasJointLowerLimit ?lower ; hw3:hasJointUpperLimit ?upper .
