# Exercise 3b · Failure Diagnosis  (STUDENT TODO)
#
# 三台機器人構成對照實驗, 讓「失敗原因」可以被推論出來:
#   your_UR5 vs ta:ta_ur5  : 同一台手臂、不同演算法
#                            -> 狀態不一致 = ALGORITHM ISSUE
#   ta:ta_ur5 vs ta:ta_ur10: 同一套演算法、不同手臂
#                            -> 狀態不一致 = PHYSICAL LIMIT (工作空間)
# 每個 target 一列, ?diagnosis 給出可解釋的歸因。
PREFIX hw3: <http://taica.course/hw3/ontology#>
PREFIX ta:  <http://taica.course/hw3/data/ta#>

SELECT *   # STUDENT TODO: ?target ?stuStatus ?taUr5Status ?taUr10Status ?diagnosis
WHERE {
  # ------------------------- your query -------------------------
  # hint: 你的機器人 = producedBy != "ta-reference-pipeline";
  #       TA 的兩台 = ta:ta_ur5 / ta:ta_ur10 (固定 URI)
  # hint: 三個 status 各查一次 (同一個 ?target join 三個 IKComputation)
  # hint: 巢狀 IF + BIND 產生 ?diagnosis:
  #   stuStatus != taUr5Status              -> ALGORITHM ISSUE
  #   stuStatus = "SOLVED"                  -> OK
  #   taUr10Status = "SOLVED"               -> PHYSICAL LIMIT of UR5
  #   otherwise                             -> BEYOND BOTH ARMS
  # ---------------------------------------------------------------
}
